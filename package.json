{
  "name": "lei-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:seasonal": "node --test scripts/seasonal.test.mjs",
    "test:daylight": "node scripts/daylight.test.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write src index.html package.json tsconfig.json README.md",
    "format:check": "prettier --check src index.html package.json tsconfig.json README.md"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "gsap": "^3.15.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  }
}
